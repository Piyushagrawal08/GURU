# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret key (Project Settings → API → service_role / secret key).
# Needed for "Forgot password". NEVER add a NEXT_PUBLIC_ prefix to this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
